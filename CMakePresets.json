{
  "version": 6,
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}"
    },
    {
      "name": "dev",
      "inherits": "base",
      "displayName": "Dev: RelWithDebInfo, warnings as errors",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "release",
      "inherits": "base",
      "displayName": "Release: -O3 -march=native for benchmarks",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_FLAGS": "-march=native"
      }
    },
    {
      "name": "asan",
      "inherits": "base",
      "displayName": "AddressSanitizer + UBSan (clang, Debug)",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_COMPILER": "clang++",
        "SANITIZER": "address"
      }
    },
    {
      "name": "tsan",
      "inherits": "base",
      "displayName": "ThreadSanitizer (clang + libomp, Linux)",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_COMPILER": "clang++",
        "SANITIZER": "thread"
      }
    },
    {
      "name": "hip",
      "inherits": "base",
      "displayName": "HIP GPU backend (ROCm: RX 9060 XT = gfx1200, Ryzen 7600X iGPU = gfx1036)",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "ENABLE_HIP": "ON",
        "CMAKE_HIP_ARCHITECTURES": "gfx1200;gfx1036",
        "CMAKE_HIP_COMPILER": "/opt/rocm/lib/llvm/bin/clang++",
        "CMAKE_HIP_COMPILER_ROCM_ROOT": "/opt/rocm",
        "CMAKE_HIP_FLAGS": "--rocm-path=/opt/rocm",
        "CMAKE_PREFIX_PATH": "/opt/rocm"
      }
    },
    {
      "name": "viewer",
      "inherits": "dev",
      "displayName": "Dev + the live viewer (planet_view, raylib)",
      "cacheVariables": {
        "ENABLE_VIEWER": "ON"
      }
    },
    {
      "name": "demo",
      "inherits": "hip",
      "displayName": "Presentation build: Release, -march=native, HIP + viewer",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_FLAGS": "-march=native",
        "ENABLE_VIEWER": "ON"
      }
    }
  ],
  "buildPresets": [
    { "name": "dev", "configurePreset": "dev" },
    { "name": "release", "configurePreset": "release" },
    { "name": "asan", "configurePreset": "asan" },
    { "name": "tsan", "configurePreset": "tsan" },
    { "name": "hip", "configurePreset": "hip" },
    { "name": "viewer", "configurePreset": "viewer" },
    { "name": "demo", "configurePreset": "demo" }
  ],
  "testPresets": [
    {
      "name": "base",
      "hidden": true,
      "output": { "outputOnFailure": true },
      "filter": { "exclude": { "label": "gpu" } }
    },
    { "name": "dev", "inherits": "base", "configurePreset": "dev" },
    { "name": "release", "inherits": "base", "configurePreset": "release" },
    {
      "name": "asan",
      "inherits": "base",
      "configurePreset": "asan",
      "environment": {
        "UBSAN_OPTIONS": "print_stacktrace=1",
        "LSAN_OPTIONS": "suppressions=${sourceDir}/tests/lsan_suppressions.txt:print_suppressions=1"
      }
    },
    {
      "name": "tsan",
      "inherits": "base",
      "configurePreset": "tsan",
      "environment": {
        "TSAN_OPTIONS": "ignore_noninstrumented_modules=1 halt_on_error=1",
        "OMP_NUM_THREADS": "4"
      }
    },
    {
      "name": "hip",
      "configurePreset": "hip",
      "output": { "outputOnFailure": true },
      "description": "Everything, including the gpu-labelled tests (needs the GPU)"
    },
    { "name": "viewer", "inherits": "base", "configurePreset": "viewer" },
    { "name": "demo", "inherits": "hip", "configurePreset": "demo" }
  ]
}
